{
  "name": "@algorismus/elementor-jsx",
  "version": "1.7.0",
  "type": "module",
  "description": "Build Elementor sites with AI agents — typed JSX in, native editable Elementor pages out over REST. Hot reload dev loop, verification gates, 400+ test certified. The exjsx CLI.",
  "bin": {
    "exjsx": "./src/cli.mjs"
  },
  "types": "./types.d.ts",
  "scripts": {
    "build": "node src/cli.mjs build",
    "deploy": "node src/cli.mjs deploy",
    "test": "node --test test/unit/*.test.mjs",
    "corpus": "node test/corpus/run.mjs",
    "test:it": "EXJSX_IT=1 node --test --test-concurrency=1 'test/integration/*.test.mjs'",
    "test:all": "npm test && npm run test:it",
    "prepublishOnly": "npm test"
  },
  "dependencies": {
    "esbuild": "^0.24.0"
  },
  "devDependencies": {
    "pixelmatch": "^7.2.0",
    "pngjs": "^7.0.0",
    "typescript": "^5.9.0"
  },
  "exports": {
    ".": "./src/x.mjs",
    "./x": "./src/x.mjs",
    "./prelude": "./src/prelude.mjs",
    "./bundler": "./src/bundler.mjs",
    "./site": "./src/site.mjs",
    "./kit": "./src/kit/kit.mjs",
    "./components": "./src/kit/kit-components.mjs",
    "./jsx-components": "./src/components/index.jsx",
    "./runtime": "./src/runtime.mjs",
    "./theme": "./src/theme.mjs",
    "./compile": "./src/compile.mjs",
    "./tw": "./src/tw.mjs",
    "./deploy": "./src/deploy.mjs",
    "./decompile": "./src/decompile.mjs",
    "./media": "./src/media.mjs",
    "./inline": "./src/inline.mjs",
    "./inspect": "./src/inspect.mjs",
    "./lint": "./src/lint.mjs",
    "./project": "./src/project.mjs"
  },
  "files": [
    "src/",
    "types.d.ts",
    "README.md",
    "CONVENTIONS.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "elementor",
    "wordpress",
    "ai",
    "ai-agents",
    "jsx",
    "compiler",
    "page-builder",
    "website-builder",
    "mcp",
    "claude",
    "cursor",
    "site-generator",
    "elementor-widgets",
    "wordpress-automation",
    "exjsx",
    "claude-code",
    "elementor-mcp",
    "ai-website-builder",
    "wordpress-ai"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Algorismus-io/elementor-jsx.git"
  },
  "bugs": {
    "url": "https://github.com/Algorismus-io/elementor-jsx/issues"
  },
  "homepage": "https://exjsx.dev",
  "author": "Algorismus <shahmir@algorismus.io> (https://algorismus.io)",
  "publishConfig": {
    "access": "public"
  }
}
