{
  "name": "elementor-jsx",
  "version": "1.0.0",
  "type": "module",
  "description": "React-level JSX -> Elementor V4 compiler + one-shot deployer. Full catalog parity (atomic elements, forms, theme parts, dynamic tags, loops, interactions, SEO), certified on Elementor 4.1.4/4.2.0 by a 396-test suite.",
  "bin": {
    "exjsx": "./src/cli.mjs"
  },
  "types": "./types.d.ts",
  "scripts": {
    "build": "node src/cli.mjs build",
    "deploy": "node src/cli.mjs deploy",
    "test": "node --test 'test/unit/*.test.mjs'",
    "test:it": "EXJSX_IT=1 node --test --test-concurrency=1 'test/integration/*.test.mjs'",
    "test:all": "npm test && npm run test:it"
  },
  "dependencies": {
    "esbuild": "^0.24.0"
  },
  "devDependencies": {
    "pixelmatch": "^7.2.0",
    "pngjs": "^7.0.0"
  },
  "exports": {
    ".": "./src/site.mjs",
    "./kit": "./src/kit/kit.mjs",
    "./components": "./src/kit/kit-components.mjs",
    "./jsx-components": "./src/components/index.jsx",
    "./runtime": "./src/runtime.mjs",
    "./theme": "./src/theme.mjs",
    "./compile": "./src/compile.mjs",
    "./deploy": "./src/deploy.mjs",
    "./decompile": "./src/decompile.mjs",
    "./media": "./src/media.mjs",
    "./inline": "./src/inline.mjs"
  },
  "files": [
    "src/",
    "types.d.ts",
    "README.md"
  ]
}